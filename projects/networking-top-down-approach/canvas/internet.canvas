{
	"nodes":[
		{"id":"b2351d2fc353e3f1","type":"text","text":"# Network\n\nSystem of data transfer, major parts: switch, connection line\n\nThe unite of transfered information is packet","x":-683,"y":-136,"width":255,"height":217},
		{"id":"39d90c6f00a2c655","type":"text","text":"# INTERNET\nInternet is a world wide computer network, interconnects smaller networks, a network of networks\n\nConnected destination systems ","x":-720,"y":-498,"width":329,"height":196},
		{"id":"08aa8c85614d109c","type":"text","text":"# Switch \n(коммутатор пакетов)\n\nRecieves a package by one of communication line and dispatch it to the next destination\n\nPart of network route\n\nTypes: router, L2 switch","x":-1110,"y":380,"width":306,"height":330},
		{"id":"e331c7cff51b0341","type":"text","text":"# Packet\nA portion of information","x":-678,"y":335,"width":250,"height":90},
		{"id":"9d93cb2e1ffa3f76","type":"file","file":"projects/networking-top-down-approach/canvas/protocols.canvas","x":-1815,"y":-498,"width":220,"height":200},
		{"id":"0871e7fe3a4fe401","type":"text","text":"# Internet Standards\nWorld Wide Web should work universally on every node, in every country, in every city\n\nCollection of IETF (Internet Engineering Task Force) standards.\n\nRFC (request for comment) has appeared while the developing of internet, contains general solutions for appearing problems\nmore than 6000 documents/specifications","x":-1260,"y":-567,"width":375,"height":335},
		{"id":"38235666c4d98605","type":"text","text":"# Connection line\nConductor, wire","x":-200,"y":488,"width":250,"height":115},
		{"id":"6fcd0045ecd7627f","type":"text","text":"# Network route\nSequence of lines of communication and package switches","x":-706,"y":483,"width":306,"height":125},
		{"id":"99c0afd15bf67bbf","type":"text","text":"# Speed of transfer \n(bit/s)","x":-678,"y":710,"width":250,"height":90},
		{"id":"2e435459481ece60","type":"text","text":"# Distributed applications\nInternet applications are executed on destination systems (browser for client, web server for server) and not on switches.","x":150,"y":-498,"width":210,"height":266},
		{"id":"b06fedfa4b62dd7b","type":"text","text":"# API\nApplication Programming Layer\n\nDefines how the program on host will interact with the internet to send the data to another specific host   ","x":480,"y":-498,"width":250,"height":259},
		{"id":"48bec72e3486673e","type":"file","file":"projects/networking-top-down-approach/canvas/network-types.canvas","x":50,"y":-118,"width":225,"height":181},
